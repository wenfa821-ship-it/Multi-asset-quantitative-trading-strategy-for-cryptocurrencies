<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job for the read-only operations dashboard.

  Do not copy this file by hand: `scripts/install_dashboard_service.sh` fills in
  __PYTHON__ / __PROJECT_DIR__ / __PORT__ with this machine's absolute paths and
  installs it into ~/Library/LaunchAgents.

  The dashboard is READ-ONLY (it opens files for reading and never writes state or
  places orders), which is why it is safe to keep alive unattended. Do NOT reuse
  this plist for the trading loop: an auto-restarting loop that places orders is a
  different risk decision.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradingagent.dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-u</string>
        <string>-m</string>
        <string>ta</string>
        <string>dashboard</string>
        <string>--config-dir</string>
        <string>config</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>__PORT__</string>
        <string>--venue</string>
        <string>okx_demo</string>
        <string>--metrics-port</string>
        <string>9101</string>
        <string>--env-file</string>
        <string>.env</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <!-- launchd starts jobs with a minimal environment: PYTHONPATH is what makes
         `python3 -m ta` resolve to this checkout rather than any installed copy. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>src</string>
        <key>TZ</key>
        <string>Asia/Shanghai</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/anaconda3/bin:/Users/wenfa/.workbuddy/binaries/python/current/bin</string>
        <!-- Needed for the live venue read: the page matches the OKX app by
             reading the balance directly, in addition to the loop's tick data. -->
        <key>HTTP_PROXY</key>
        <string>http://127.0.0.1:7897</string>
        <key>HTTPS_PROXY</key>
        <string>http://127.0.0.1:7897</string>
        <key>NO_PROXY</key>
        <string>localhost,127.0.0.1,::1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/ta-dash-service.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/ta-dash-service.err.log</string>
</dict>
</plist>
