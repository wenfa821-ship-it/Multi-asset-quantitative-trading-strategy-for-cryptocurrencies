# Copy to .env and fill in. NEVER commit the real file.
# Load with: set -a; source .env; set +a   (or use direnv / 1Password CLI / Vault)

# --- OKX Demo Trading -------------------------------------------------------
# Create keys inside the OKX "Demo Trading" environment, not your live account.
# Required permissions: Read + Trade. WITHDRAW MUST STAY DISABLED. Bind an IP whitelist.
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET=
OKX_DEMO_PASSPHRASE=

# --- Binance Spot Testnet ---------------------------------------------------
# Keys from https://testnet.binance.vision (Spot) or https://testnet.binancefuture.com (USDⓈ-M)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# --- Optional alerting ------------------------------------------------------
TA_ALERT_WEBHOOK_URL=

